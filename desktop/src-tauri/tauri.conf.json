{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tailmux",
  "version": "0.0.0",
  "identifier": "gg.growly.tailmux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/ensure-sidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Many tailnets at once",
    "externalBin": ["binaries/tailmux"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["policykit-1"] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
